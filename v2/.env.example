# Copiar a .env y completar. NUNCA subir .env a git.
# Raíz del proyecto (donde viven 01_INPUTS, 02_OUTPUTS, 03_LOGS, 04_CACHE). Vacío = carpeta padre del paquete.
REPORTERIA_RAIZ=
# Dimensionales locales (DuckDB versionado en git). Vacío = v2/dim/dimensionales.duckdb del paquete.
REPORTERIA_DIM=
# Fuentes corporativas (se leen donde están)
RUTA_CUBO_DIR=\\servidor\ruta\al\CUBO
RUTA_BIX=\\servidor\ruta\a\3.- BIX
# SQL beemining (FX)
BEE_SERVER=
BEE_DB=
BEE_UID=
BEE_PWD=
# Facts (facturas): túnel SSH + Postgres. Secretos solo aquí; host y usuarios con los valores del proveedor
MONEDA_BI_PASSWORD=
MONEDA_BI_SSH_KEY=~/.ssh/id_ed25519
FACTS_SSH_HOST=moneda.facts.cl
FACTS_SSH_PORT=22
FACTS_SSH_USER=bi
FACTS_DB=facts
FACTS_DB_USER=bi_readonly
FACTS_DB_PORT=5432
